{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimesis.be/schemas/patient_context.schema.json",
  "title": "PatientContext",
  "description": "Patient clinical context and regimen parameters for CINV decision support. Pseudonymized; no PII.",
  "type": "object",
  "required": [
    "patient_id",
    "age_years",
    "weight_kg",
    "bsa_m2",
    "chemo_regimen"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Pseudonymous identifier for the patient (e.g. PAT-2026-0042)"
    },
    "display_pseudonym": {
      "type": "string",
      "description": "Friendly pseudonym or initials (e.g. 'Emma D.')"
    },
    "age_years": {
      "type": "number",
      "minimum": 0,
      "maximum": 21,
      "description": "Patient age in years at treatment start"
    },
    "weight_kg": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 150.0,
      "description": "Weight in kilograms"
    },
    "bsa_m2": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 3.0,
      "description": "Current BSA snapshot in m². Dose calculations select the latest dated bsa_measurements observation when present."
    },
    "diagnosis": {
      "type": "string",
      "description": "Oncological diagnosis (e.g. 'B-cell ALL', 'Osteosarcoma')"
    },
    "protocol_name": {
      "type": "string",
      "description": "Chemotherapy protocol/trial name (e.g. 'AIEOP-BFM ALL 2017')"
    },
    "current_cycle": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Current chemotherapy treatment cycle number"
    },
    "chemo_regimen": {
      "type": "array",
      "description": "Antineoplastic medications planned for this cycle",
      "items": {
        "type": "object",
        "required": [
          "drug_name",
          "dose_mg_per_m2",
          "day_numbers"
        ],
        "properties": {
          "drug_name": {
            "type": "string",
            "description": "Standard INN drug name (e.g. 'Cisplatin', 'Doxorubicin', 'Cyclophosphamide')"
          },
          "dose_mg_per_m2": {
            "type": "number",
            "description": "Dose per mÂ² BSA"
          },
          "day_numbers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Days of cycle when drug is infused (e.g. [1, 2, 3])"
          },
          "infusion_duration_hours": {
            "type": "number",
            "description": "Duration of infusion in hours"
          },
          "route": {
            "type": "string",
            "description": "Actual chemotherapy administration route, used by Story 1 classification.",
            "enum": [
              "IV",
              "PO",
              "IT",
              "ITT"
            ]
          }
        }
      }
    },
    "history_previous_cycles": {
      "type": "object",
      "properties": {
        "had_refractory_cinv": {
          "type": "boolean",
          "default": false,
          "description": "True if patient experienced breakthrough or refractory nausea/vomiting in prior cycle"
        },
        "prior_episode_count": {
          "type": "integer",
          "default": 0,
          "description": "Count of emetic episodes recorded in previous cycle"
        },
        "anticipatory_nausea": {
          "type": "boolean",
          "default": false,
          "description": "True if anticipatory nausea observed"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "allergies_and_contraindications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documented drug allergies or contraindications (e.g. 'QTc prolongation', '5-HT3 hypersensitivity')"
    },
    "preferred_formulation": {
      "type": "string",
      "enum": [
        "oral_liquid",
        "oral_tablet",
        "iv",
        "orodispersible"
      ],
      "default": "iv",
      "description": "Patient's preferred or clinically necessary drug formulation route"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form labels shown as chips in the UI. 'demo' marks fictional demo patients (loaded/cleared by infra/scripts/demo-data.sh)."
    },
    "sex": {
      "type": "string",
      "enum": [
        "F",
        "M"
      ],
      "description": "Extension (mock-api): sex"
    },
    "height_cm": {
      "type": "number",
      "description": "Extension (mock-api): height in cm"
    },
    "diagnosis_group": {
      "type": "string",
      "description": "Extension (mock-api): diagnosis group used by the dexamethasone rule, e.g. 'ALL', 'brain_tumour', 'solid'"
    },
    "cycle_label": {
      "type": "string",
      "description": "Extension (mock-api): human cycle label, e.g. 'B4', 'Day 8', 'IE #3', 'C1'"
    },
    "cycle_start_date": {
      "type": "string",
      "format": "date",
      "description": "Extension (mock-api): start date (day 1) of the current cycle, YYYY-MM-DD"
    },
    "active_medications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extension (mock-api): current non-chemo medications (INN, lower case), used for interaction checks"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "nl",
        "fr",
        "en"
      ],
      "description": "Extension (mock-api): family's language for the passport"
    },
    "pairing_code": {
      "type": "string",
      "description": "Extension (mock-api): code a family enters in the companion app to link to this patient"
    },
    "previous_cycles": {
      "type": "array",
      "description": "Extension (mock-api): per-cycle history (history_previous_cycles is the summary of the last one)",
      "items": {
        "type": "object",
        "required": [
          "cycle_label"
        ],
        "properties": {
          "cycle_label": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "antiemetics": {
            "type": "string",
            "description": "Antiemetics given in that cycle (free text)"
          },
          "nausea_days": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "vomiting_days": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "risk_factors": {
      "type": "object",
      "description": "Extension (mock-api): default risk factors / formulation for new plans",
      "properties": {
        "can_swallow_tablets": {
          "type": "boolean"
        },
        "preferred_route": {
          "type": "string",
          "enum": [
            "oral_tablet",
            "oral_liquid",
            "ng_tube",
            "iv"
          ]
        },
        "anticipatory": {
          "type": "boolean"
        },
        "prior_nausea_note": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bsa_measured_at": {
      "type": "string",
      "format": "date-time",
      "description": "Measurement time of the current BSA snapshot, with timezone."
    },
    "bsa_measurements": {
      "type": "array",
      "description": "Append-only BSA observations. Latest measurement time wins; equal timestamps with different values require correction.",
      "items": {
        "type": "object",
        "required": [
          "bsa_m2",
          "measured_at"
        ],
        "properties": {
          "bsa_m2": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          },
          "measured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "time_basis": {
            "type": "string",
            "enum": [
              "measurement",
              "recorded"
            ]
          }
        }
      }
    }
  }
}
