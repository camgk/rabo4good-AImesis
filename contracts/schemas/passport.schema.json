{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimesis.be/schemas/passport.schema.json",
  "title": "CinvPassport",
  "description": "CINV Patient Passport for pediatric oncology antiemetic prophylaxis (UZA v2 protocol). Supports dual clinician sign-off and multi-language family schedules.",
  "type": "object",
  "required": [
    "passport_id",
    "patient_id",
    "cycle_number",
    "status",
    "emetogenicity_tier",
    "antiemetic_schedule",
    "breakthrough_plan",
    "signoffs"
  ],
  "properties": {
    "passport_id": {
      "type": "string",
      "description": "Unique Passport identifier (e.g. PSP-2026-0042-C1)"
    },
    "patient_id": {
      "type": "string",
      "description": "Associated patient ID"
    },
    "cycle_number": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_pharmacist",
        "pending_oncologist",
        "active",
        "completed",
        "superseded"
      ],
      "default": "draft"
    },
    "emetogenicity_tier": {
      "type": "string",
      "enum": [
        "HIGH",
        "MODERATE",
        "LOW",
        "MINIMAL"
      ],
      "description": "UZA v2 overall emetic risk tier calculated for this regimen"
    },
    "classification_rationale": {
      "type": "string",
      "description": "Clinical justification citing UZA v2 rules (e.g. 'Cisplatin >= 50 mg/m² is Tier HIGH (UZA v2 p.1)')"
    },
    "antiemetic_schedule": {
      "type": "array",
      "description": "Planned prophylactic antiemetic drugs and timing",
      "items": {
        "type": "object",
        "required": [
          "drug_name",
          "dose_amount",
          "dose_unit",
          "route",
          "frequency",
          "cycle_days",
          "rule_citation"
        ],
        "properties": {
          "drug_name": {
            "type": "string",
            "description": "Antiemetic INN name (e.g. 'Ondansetron', 'Aprepitant', 'Dexamethasone', 'Fosaprepitant')"
          },
          "dose_amount": {
            "type": "number",
            "description": "Calculated dose amount for this patient's BSA/weight"
          },
          "dose_unit": {
            "type": "string",
            "default": "mg"
          },
          "formula_used": {
            "type": "string",
            "description": "Formula explanation (e.g. '5 mg/m² * 1.1 m² = 5.5 mg (rounded to 5 mg; max 8 mg)')"
          },
          "route": {
            "type": "string",
            "enum": [
              "iv",
              "oral_liquid",
              "oral_capsule",
              "oral_tablet",
              "orodispersible"
            ]
          },
          "frequency": {
            "type": "string",
            "description": "Timing/frequency (e.g. 'q8h', 'once daily 1h before chemotherapy', 'q12h')"
          },
          "cycle_days": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Days of cycle when given (e.g. [1, 2, 3, 4])"
          },
          "rule_citation": {
            "type": "string",
            "description": "Specific guideline citation (e.g. 'UZA v2 p.2 · Ondansetron 5 mg/m², max 8 mg/dose')"
          },
          "day_label": {
            "type": "string",
            "description": "Extension: human label for cycle_days (e.g. 'D2–D3')"
          },
          "duration": {
            "type": "string",
            "description": "Extension: duration as stated by UZA v2"
          },
          "route_options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extension: all routes the rule allows (route is the one chosen for this patient)"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dexamethasone_rules": {
      "type": "object",
      "required": [
        "is_blocked",
        "rationale"
      ],
      "properties": {
        "is_blocked": {
          "type": "boolean",
          "description": "True if dexamethasone is blocked (e.g. tumor lysis risk, leukemia induction, CAR-T, or already included in protocol)"
        },
        "rationale": {
          "type": "string",
          "description": "Rule citation explaining inclusion or block"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extension: every contraindication found (empty when allowed)"
        },
        "aprepitant_dose_reduction": {
          "type": "boolean",
          "description": "Extension: dose halved for CYP3A4 interaction with (fos)aprepitant"
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "breakthrough_plan": {
      "type": "object",
      "required": [
        "rescue_steps",
        "instructions"
      ],
      "properties": {
        "rescue_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step_number",
              "drug_name",
              "dose",
              "route",
              "rule_citation"
            ],
            "properties": {
              "step_number": {
                "type": "integer"
              },
              "drug_name": {
                "type": "string"
              },
              "dose": {
                "type": "string"
              },
              "route": {
                "type": "string"
              },
              "max_daily_frequency": {
                "type": "string"
              },
              "rule_citation": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "description": "Extension: full UZA v2 step text"
              }
            }
          }
        },
        "instructions": {
          "type": "string",
          "description": "Instructions for family and nursing staff when nausea occurs"
        }
      }
    },
    "signoffs": {
      "type": "object",
      "required": [
        "requires_dual_signoff",
        "advisory_notice"
      ],
      "properties": {
        "requires_dual_signoff": {
          "type": "boolean",
          "default": true
        },
        "advisory_notice": {
          "type": "string",
          "default": "Advisory only — requires clinician sign-off"
        },
        "oncologist": {
          "type": "object",
          "properties": {
            "signed": {
              "type": "boolean",
              "default": false
            },
            "clinician_name": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "riziv_inami": {
              "type": "string"
            }
          }
        },
        "clinical_pharmacist": {
          "type": "object",
          "properties": {
            "signed": {
              "type": "boolean",
              "default": false
            },
            "clinician_name": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "riziv_inami": {
              "type": "string"
            }
          }
        }
      }
    },
    "family_schedule_multilingual": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "daily_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "what_to_do_if_vomiting": {
              "type": "string"
            }
          }
        },
        "fr": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "daily_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "what_to_do_if_vomiting": {
              "type": "string"
            }
          }
        },
        "en": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "daily_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "what_to_do_if_vomiting": {
              "type": "string"
            }
          }
        }
      }
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "phone_number"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          }
        }
      }
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_pharmacist",
        "approved",
        "returned"
      ],
      "description": "Extension (mock-api): plan workflow state. status becomes 'active' once both sign-offs exist"
    },
    "comments": {
      "type": "array",
      "description": "Extension (mock-api): review comments",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "risk_factors": {
      "type": "object",
      "description": "Extension (mock-api): risk-factor snapshot the plan was computed with (same shape as patient risk_factors)",
      "properties": {
        "can_swallow_tablets": {
          "type": "boolean"
        },
        "preferred_route": {
          "type": "string"
        },
        "anticipatory": {
          "type": "boolean"
        },
        "prior_nausea_note": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extension (mock-api): copied from the patient so demo passports are clearable"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generation": {
      "type": "object",
      "description": "Extension (agent): how and when this passport was computed",
      "required": [
        "generated_at",
        "generator",
        "policy_version",
        "benchmark_version",
        "advisory_status"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "benchmark_version": {
          "type": "string"
        },
        "advisory_status": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Extension (agent): every value the rules engine was run with, and where it came from",
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "patient_record",
              "derived",
              "default"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "description": "Extension (agent): refuse rather than guess",
      "required": [
        "refused",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "refused": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "message",
              "citation"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "description": "Extension (agent): UZA v2 p.1 regimen classification",
      "required": [
        "overall_tier",
        "drugs",
        "days",
        "combination_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "overall_tier": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "HIGH",
                "MODERATE",
                "LOW",
                "MINIMAL"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "drugs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "drug",
              "dose_mg_m2",
              "days",
              "tier",
              "rule_citation"
            ],
            "additionalProperties": false,
            "properties": {
              "drug": {
                "type": "string"
              },
              "dose_mg_m2": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "tier": {
                "type": "string",
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW",
                  "MINIMAL"
                ]
              },
              "rule_citation": {
                "type": "string"
              }
            }
          }
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "tier",
              "drugs"
            ],
            "additionalProperties": false,
            "properties": {
              "day": {
                "type": "integer"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW",
                  "MINIMAL"
                ]
              },
              "drugs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "combination_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dose_review": {
      "type": "array",
      "description": "Extension (agent): every UZA v2 p.2 dose line, including those not indicated, for clinician review",
      "items": {
        "type": "object",
        "required": [
          "drug",
          "indicated",
          "dose_text",
          "frequency",
          "duration",
          "route",
          "formula",
          "citation",
          "warnings",
          "administrations"
        ],
        "additionalProperties": false,
        "properties": {
          "drug": {
            "type": "string"
          },
          "indicated": {
            "type": "boolean"
          },
          "dose_text": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "administrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dose_amount",
                "dose_unit",
                "cycle_days",
                "day_label"
              ],
              "additionalProperties": false,
              "properties": {
                "dose_amount": {
                  "type": "number"
                },
                "dose_unit": {
                  "type": "string"
                },
                "cycle_days": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "day_label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "personalization": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extension (agent): UZA v2 p.2 personalization overrides applied"
    },
    "safety": {
      "type": "object",
      "description": "Extension (agent): drug-interaction and QTc screening",
      "required": [
        "interactions",
        "highest_severity",
        "safe_to_proceed_without_modification",
        "qtc",
        "recommended_modifications"
      ],
      "additionalProperties": false,
      "properties": {
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interacting_pair",
              "severity",
              "kind",
              "mechanism",
              "clinical_action",
              "safe_alternative",
              "citation"
            ],
            "additionalProperties": false,
            "properties": {
              "interacting_pair": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "clinical_action": {
                "type": "string"
              },
              "safe_alternative": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              }
            }
          }
        },
        "highest_severity": {
          "type": "string"
        },
        "safe_to_proceed_without_modification": {
          "type": "boolean"
        },
        "recommended_modifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qtc": {
          "type": "object",
          "required": [
            "risk_tier",
            "cumulative_score",
            "contributors"
          ],
          "additionalProperties": false,
          "properties": {
            "risk_tier": {
              "type": "string"
            },
            "cumulative_score": {
              "type": "number"
            },
            "baseline_qtc_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "clinical_alert": {
              "type": "string"
            },
            "citation": {
              "type": "string"
            },
            "contributors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "drug",
                  "category",
                  "score",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "drug": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "pogo_comparison": {
      "type": "object",
      "description": "Extension (agent): UZA v2 vs POGO 2025 benchmark (UZA v2 is the source of truth)",
      "required": [
        "has_differences",
        "drugs",
        "combination_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "has_differences": {
          "type": "boolean"
        },
        "drugs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "drug",
              "uza_tier",
              "pogo_tier",
              "differs",
              "explanation",
              "uza_citation",
              "pogo_citation"
            ],
            "additionalProperties": false,
            "properties": {
              "drug": {
                "type": "string"
              },
              "dose_mg_m2": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "uza_tier": {
                "type": "string"
              },
              "pogo_tier": {
                "type": "string"
              },
              "differs": {
                "type": "boolean"
              },
              "explanation": {
                "type": "string"
              },
              "uza_citation": {
                "type": "string"
              },
              "pogo_citation": {
                "type": "string"
              }
            }
          }
        },
        "combination_notes": {
          "type": "array",
          "items": {}
        },
        "prophylaxis_comparison": {
          "type": "object"
        }
      }
    },
    "review_flags": {
      "type": "array",
      "description": "Extension (agent): items the clinician must actively judge before sign-off",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          }
        }
      }
    }
  }
}
